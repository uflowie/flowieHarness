{
	"compilerOptions": {
		"target": "ES2023",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"types": [
			"vite/client"
		],
		"paths": {
			"pi-durable-transcript": [
				"../node_modules/@earendil-works/pi-durable/dist/harness/transcript.d.ts"
			],
			"@/*": [
				"./src/*"
			]
		},
		"baseUrl": "."
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
